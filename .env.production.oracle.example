# MÁQUINA DE ORACLE (solo la base de datos). Copiar a .env EN ESA MÁQUINA y completar:
#   cp .env.production.oracle.example .env && chmod 600 .env
# Este archivo NO lleva secretos y sí se versiona; el .env real está en .gitignore y NUNCA se sube.
# La máquina del backend usa OTRA plantilla (.env.production.backend.example). Aquí NO van JWT_SECRET ni las cuentas
# de ADMIN y CLIENTE.
#
# Los valores no pueden llevar comillas, "$" ni "\" (Oracle y Docker Compose los interpretan): usa solo letras y números.

# Usuario SYS/SYSTEM del contenedor Oracle (solo lo usa Docker para inicializar). Solo existe en esta máquina.
#   sed -i "s|^ORACLE_PASSWORD=.*|ORACLE_PASSWORD=$(openssl rand -hex 24)|" .env
ORACLE_PASSWORD=

# Un esquema (usuario de Oracle) por servicio, con permisos mínimos y sin DBA. Se crean UNA sola vez, al CREAR el volumen
# de Oracle: cambiarlos después exige recrear el volumen (y se pierden los datos). Claves distintas para cada uno:
#   sed -i "s|^AUTH_DB_PASS=.*|AUTH_DB_PASS=$(openssl rand -hex 24)|" .env
#   sed -i "s|^TIENDA_DB_PASS=.*|TIENDA_DB_PASS=$(openssl rand -hex 24)|" .env
#   sed -i "s|^ARRIENDOS_DB_PASS=.*|ARRIENDOS_DB_PASS=$(openssl rand -hex 24)|" .env
# El backend debe tener EXACTAMENTE los mismos usuarios y claves: cópialos a su .env (por scp, nunca por chat ni correo).
#   ms-auth -> usuarios y roles · ms-tienda -> productos y órdenes · ms-arriendos -> máquinas, arriendos y cotizaciones
AUTH_DB_USER=FERREFIX_AUTH
AUTH_DB_PASS=
TIENDA_DB_USER=FERREFIX_TIENDA
TIENDA_DB_PASS=
ARRIENDOS_DB_USER=FERREFIX_ARRIENDOS
ARRIENDOS_DB_PASS=

# Opcional: atar el puerto 1521 a una sola interfaz (la IP privada de esta máquina). Sin definirla, se publica en todas
# las interfaces y la protección es el grupo de seguridad: el 1521 solo debe aceptar conexiones del grupo del backend.
#ORACLE_BIND_IP=10.0.2.15
