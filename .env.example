# Copiar a .env y completar. .env está en .gitignore: NUNCA se sube.

# Usuario SYS/SYSTEM del contenedor Oracle (solo lo usa Docker para inicializar)
ORACLE_PASSWORD=

# Usuario de la aplicación (se crea con permisos mínimos, sin DBA)
DB_USER=ferrefix
DB_PASS=
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=FREEPDB1

# Clave de firma JWT (se usa como TEXTO, no como Base64). Mínimo 64 bytes UTF-8 (firma HS512):
# genera una de 128 caracteres hexadecimales (128 bytes) con:  openssl rand -hex 64
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Origen del frontend (separar con coma). Producción: http://<ELASTIC_IP>:<puerto>
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Usuarios iniciales (mín. 8 caracteres; si queda vacía, ese usuario no se crea)
ADMIN_EMAIL=admin@ferrefix.cl
ADMIN_PASSWORD=
CLIENT_EMAIL=cliente@ferrefix.cl
CLIENT_PASSWORD=
