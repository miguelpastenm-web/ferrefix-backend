# Copiar a .env y completar. .env está en .gitignore: NUNCA se sube.

# Usuario SYS/SYSTEM del contenedor Oracle (solo lo usa Docker para inicializar)
ORACLE_PASSWORD=

# Un esquema (usuario de Oracle) por servicio, con permisos mínimos y sin DBA. Los crea docker/oracle/01-crear-esquemas.sh
# al crear el volumen de Oracle por primera vez. Los nombres: letras, números y _ (sin comillas ni espacios).
#   ms-auth    -> usuarios y roles
#   ms-tienda  -> productos, órdenes, máquinas, arriendos y cotizaciones
AUTH_DB_USER=FERREFIX_AUTH
AUTH_DB_PASS=
TIENDA_DB_USER=FERREFIX_TIENDA
TIENDA_DB_PASS=

# Dirección de la base. NO las definas si Oracle corre en el compose (se usa el contenedor "oracle", puerto 1521) ni
# para ejecutar un servicio fuera de Docker (se usa localhost:1521). Solo si Oracle está en otra máquina:
#   DB_HOST=10.0.2.15
#   DB_PORT=1521
#   DB_SERVICE=FREEPDB1

# Clave de firma JWT (se usa como TEXTO, no como Base64). Mínimo 64 bytes UTF-8 (firma HS512):
# genera una de 128 caracteres hexadecimales (128 bytes) con:  openssl rand -hex 64
# La misma clave la usan ms-auth (emite los tokens) y ms-tienda (verifica la firma). El gateway no la conoce.
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Origen del frontend (separar con coma). Producción: http://<ELASTIC_IP>:<puerto>
# Lo lee ms-gateway: CORS se resuelve solo ahí (los servicios no añaden cabeceras CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Usuarios iniciales, los crea ms-auth al arrancar (mín. 8 caracteres; si queda vacía, ese usuario no se crea)
ADMIN_EMAIL=admin@ferrefix.cl
ADMIN_PASSWORD=
CLIENT_EMAIL=cliente@ferrefix.cl
CLIENT_PASSWORD=
