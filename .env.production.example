# Producción (EC2). Copiar a .env EN EL SERVIDOR y completar a mano o con los comandos de abajo.
# Este archivo NO lleva secretos y sí se versiona; el .env real está en .gitignore y NUNCA se sube.
#   cp .env.production.example .env && chmod 600 .env
#
# Los valores no pueden llevar comillas, "$" ni "\" (Oracle y Docker Compose los interpretan): usa solo letras y números.

# Usuario SYS/SYSTEM del contenedor Oracle (solo lo usa Docker para inicializar).
#   sed -i "s|^ORACLE_PASSWORD=.*|ORACLE_PASSWORD=$(openssl rand -hex 24)|" .env
ORACLE_PASSWORD=

# Usuario de la aplicación (se crea con permisos mínimos, sin DBA). Solo se aplican al CREAR el volumen de Oracle:
# cambiarlos después exige recrear el volumen (y se pierden los datos).
#   sed -i "s|^DB_PASS=.*|DB_PASS=$(openssl rand -hex 24)|" .env
DB_USER=ferrefix
DB_PASS=

# Clave de firma JWT: 128 caracteres hexadecimales. Se usa como TEXTO (no como Base64) y con 64 bytes o más se firma
# con HS512. Generar con:
#   sed -i "s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -hex 64)|" .env
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Origen del frontend, tal como lo envía el navegador (sin puerto si es el 80). Varios: separados por coma.
CORS_ALLOWED_ORIGINS=http://35.174.124.246

# Cuentas iniciales. Se crean UNA sola vez, al primer arranque con la base vacía, y solo si la clave trae 8 o más
# caracteres; cambiarla en este archivo después NO la actualiza. Usa claves largas y distintas de las de desarrollo.
ADMIN_EMAIL=admin@ferrefix.cl
ADMIN_PASSWORD=
CLIENT_EMAIL=cliente@ferrefix.cl
CLIENT_PASSWORD=
