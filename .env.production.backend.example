# MÁQUINA DEL BACKEND (gateway + ms-auth + ms-tienda + ms-arriendos). Copiar a .env EN ESA MÁQUINA y completar:
#   cp .env.production.backend.example .env && chmod 600 .env
# Este archivo NO lleva secretos y sí se versiona; el .env real está en .gitignore y NUNCA se sube.
# La máquina de Oracle usa OTRA plantilla (.env.production.oracle.example). Aquí NO va ORACLE_PASSWORD.
#
# Los valores no pueden llevar comillas, "$" ni "\" (Oracle y Docker Compose los interpretan): usa solo letras y números.

# Dónde está Oracle: IP PRIVADA de la máquina Oracle dentro de la VPC (obligatoria; el compose no arranca sin ella).
#   sed -i "s|^DB_HOST=.*|DB_HOST=10.0.2.15|" .env
DB_HOST=
#DB_PORT=1521
#DB_SERVICE=FREEPDB1

# Un esquema (usuario de Oracle) por servicio. DEBEN SER IGUALES a los de la máquina Oracle: allí se crean con estas
# mismas claves y aquí se usan para conectarse. Genera las claves en una máquina y copia las mismas a la otra (por scp,
# nunca por chat ni correo).
#   ms-auth -> usuarios y roles · ms-tienda -> productos y órdenes · ms-arriendos -> máquinas, arriendos y cotizaciones
AUTH_DB_USER=FERREFIX_AUTH
AUTH_DB_PASS=
TIENDA_DB_USER=FERREFIX_TIENDA
TIENDA_DB_PASS=
ARRIENDOS_DB_USER=FERREFIX_ARRIENDOS
ARRIENDOS_DB_PASS=

# Clave de firma JWT: 128 caracteres hexadecimales. Se usa como TEXTO (no como Base64) y con 64 bytes o más se firma
# con HS512. Generar con:
#   sed -i "s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -hex 64)|" .env
# La misma clave la usan ms-auth (emite los tokens), ms-tienda y ms-arriendos (verifican la firma). El gateway no la conoce.
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Origen del front, tal como lo envía el navegador: esquema + IP pública del front (sin puerto si es el 80). Varios:
# separados por coma. Obligatorio. Lo lee ms-gateway: CORS se resuelve solo ahí.
#   sed -i "s|^CORS_ALLOWED_ORIGINS=.*|CORS_ALLOWED_ORIGINS=http://IP-PUBLICA-DEL-FRONT|" .env
CORS_ALLOWED_ORIGINS=

# Cuentas iniciales (las crea ms-auth). Se crean UNA sola vez, al primer arranque con la base vacía, y solo si la clave trae
# 8 o más caracteres; cambiarla en este archivo después NO la actualiza. Usa claves largas y distintas de las de desarrollo.
ADMIN_EMAIL=admin@ferrefix.cl
ADMIN_PASSWORD=
CLIENT_EMAIL=cliente@ferrefix.cl
CLIENT_PASSWORD=

# Opcional: límite de memoria de cada JVM. Los 4 servicios comparten la máquina (recomendada: t3.large, 8 GB); sin
# límite cada JVM puede tomar hasta un cuarto de la memoria de la máquina. Se aplica a los 4 por igual.
#JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m
