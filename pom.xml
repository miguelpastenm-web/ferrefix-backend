<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/>
	</parent>

	<groupId>cl.ferrefix</groupId>
	<artifactId>ferrefix-backend-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>ferrefix-backend</name>
	<description>Backend de Ferrefix: proyecto raíz que agrupa los microservicios</description>

	<!-- ms-* son servicios Spring Boot, cada uno con su propio jar; ferrefix-common es la librería que comparten.
	     Desde la raíz: ./mvnw test (todos) o ./mvnw -pl ms-tienda -am test (uno solo, con lo que necesita). -->
	<modules>
		<module>ferrefix-common</module>
		<module>ms-gateway</module>
		<module>ms-auth</module>
		<module>ms-tienda</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<spring-cloud.version>2025.1.4</spring-cloud.version>
		<jjwt.version>0.12.5</jjwt.version>
		<springdoc.version>3.0.3</springdoc.version>
	</properties>

	<!-- Solo fija versiones (Spring Cloud Gateway y la librería compartida): no agrega dependencias a ningún módulo. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>cl.ferrefix</groupId>
				<artifactId>ferrefix-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
